{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:integration": "vitest --config vitest.integration.config.js",
    "test:integration:watch": "vitest --config vitest.integration.config.js --watch",
    "db:connect": "docker-compose exec database psql -U postgres -d cognilytics_mis",
    "db:users": "docker-compose exec database psql -U postgres -d cognilytics_mis -c 'SELECT user_id, email, first_name, last_name, role, is_active, created_at FROM users ORDER BY created_at;'",
    "db:tables": "docker-compose exec database psql -U postgres -d cognilytics_mis -c '\\dt'"
  },
  "vitest": {
    "test": {
      "include": [
        "tests/**/*.{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "CogniLytics MIS Backend - Cognitive Load Measurement System",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "pg-promise": "^11.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-jest": "^30.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "vitest": "^4.0.16"
  }
}
